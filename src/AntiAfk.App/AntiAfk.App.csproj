<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AntiAFK</AssemblyName>
    <RootNamespace>AntiAfk.App</RootNamespace>
    <ApplicationTitle>AntiAFK</ApplicationTitle>
    <Product>AntiAFK</Product>
    <Company>BxdiS</Company>
    <!-- Ends up as AssemblyDescriptionAttribute and as the Comments field of the Win32 version
         resource - verified by reading both off a build, not assumed. Not FileDescription: that
         comes from AssemblyTitle and reads "AntiAFK". Either way the string is embedded in the
         shipped exe and legible to anything scanning it, and the old value ("marketplace activity
         bot") named an internal mechanism in words that invite a heuristic to draw conclusions. -->
    <Description>AntiAFK app for Majestic RP</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is deliberately left at the WinForms default (SystemAware).

         PerMonitorV2 was set here by H-2 on the theory that SystemAware virtualisation was what
         made clicks land in the wrong place. That was a guess, not a diagnosis - the commit message
         says "a plausible root cause" - and it changes the meaning of every screen coordinate the
         app computes, because Cursor.Position, GetWindowRect and CopyFromScreen all switch from
         virtualised to physical pixels. v1.1.8, which clicks reliably, ran SystemAware, so this is
         the one coordinate-semantics difference between it and the broken build. Reverted until
         there is evidence that scaling is actually involved.

         DisplayDiagnostics still logs every monitor's effective scale at startup, so if a non-100%
         display turns out to be the problem it will be visible in the log rather than guessed at. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The release asset must stay a single portable file: the README promises one .exe, and
         GitHubUpdateService applies updates by moving the downloaded AntiAFK.exe over the running
         one. A plain self-contained publish emits ~247 loose files, so the uploaded exe alone
         would not run and auto-update would break existing installs.
         IncludeNativeLibrariesForSelfExtract is required as well - without it the WindowsDesktop
         native libraries (wpfgfx_cor3, PresentationNative_cor3, D3DCompiler_47_cor3, PenImc_cor3,
         vcruntime140_cor3) are left next to the exe instead of being bundled. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- DebugType only suppresses this project's own symbols; without this the referenced
         Core/Infrastructure .pdb files are still copied next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- PublishAot is intentionally NOT used: RichTextBox registers an IRichEditOleCallback via
         COM on handle creation (RichTextBox.OnHandleCreated -> UpdateOleCallback), and the
         source-generated COM interop path required by Native AOT throws
         "System.InvalidCastException: Specified cast is not valid." there. This is a known
         WinForms/NativeAOT incompatibility, not something fixable from app code. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiAfk.Core\AntiAfk.Core.csproj" />
    <ProjectReference Include="..\AntiAfk.Infrastructure\AntiAfk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
