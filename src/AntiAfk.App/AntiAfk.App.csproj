<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AntiAFK</AssemblyName>
    <RootNamespace>AntiAfk.App</RootNamespace>
    <ApplicationTitle>AntiAFK</ApplicationTitle>
    <Product>AntiAFK</Product>
    <Company>BxdiS</Company>
    <Description>AntiAFK marketplace activity bot</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The release asset must stay a single portable file: the README promises one .exe, and
         GitHubUpdateService applies updates by moving the downloaded AntiAFK.exe over the running
         one. A plain self-contained publish emits ~247 loose files, so the uploaded exe alone
         would not run and auto-update would break existing installs.
         IncludeNativeLibrariesForSelfExtract is required as well - without it the WindowsDesktop
         native libraries (wpfgfx_cor3, PresentationNative_cor3, D3DCompiler_47_cor3, PenImc_cor3,
         vcruntime140_cor3) are left next to the exe instead of being bundled. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- DebugType only suppresses this project's own symbols; without this the referenced
         Core/Infrastructure .pdb files are still copied next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- PublishAot is intentionally NOT used: RichTextBox registers an IRichEditOleCallback via
         COM on handle creation (RichTextBox.OnHandleCreated -> UpdateOleCallback), and the
         source-generated COM interop path required by Native AOT throws
         "System.InvalidCastException: Specified cast is not valid." there. This is a known
         WinForms/NativeAOT incompatibility, not something fixable from app code. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiAfk.Core\AntiAfk.Core.csproj" />
    <ProjectReference Include="..\AntiAfk.Infrastructure\AntiAfk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
