<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AntiAFK</AssemblyName>
    <RootNamespace>AntiAfk.App</RootNamespace>
    <ApplicationTitle>AntiAFK</ApplicationTitle>
    <Product>AntiAFK</Product>
    <Company>BxdiS</Company>
    <Description>AntiAFK marketplace activity bot</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- WinForms is not officially AOT-supported, but this app's UI surface (NotifyIcon, plain Form/RichTextBox/ComboBox)
         avoids the trim-unsafe paths (no designer resx, no data binding, no BinaryFormatter). Verified against a real
         MSVC-linked build in CI before relying on this. -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiAfk.Core\AntiAfk.Core.csproj" />
    <ProjectReference Include="..\AntiAfk.Infrastructure\AntiAfk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
