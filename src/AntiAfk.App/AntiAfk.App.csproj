<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AntiAFK</AssemblyName>
    <RootNamespace>AntiAfk.App</RootNamespace>
    <ApplicationTitle>AntiAFK</ApplicationTitle>
    <Product>AntiAFK</Product>
    <Company>BxdiS</Company>
    <Description>AntiAFK marketplace activity bot</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Every coordinate this app works with is a physical screen pixel: it reads pixels via
         CopyFromScreen, positions the cursor via Cursor.Position and measures the game window via
         GetWindowRect. The WinForms default is SystemAware, under which Windows virtualises those
         coordinates on any display not at the system scale - so what the app computes and where
         the click lands drift apart. That is worst in a mixed-DPI setup, where moving a window
         between monitors changes the effective scale.

         PerMonitorV2 opts out of that virtualisation, so the app sees real pixels on every
         monitor. At 100% scale nothing changes, which is the common case for a fullscreen game.
         This belongs here rather than in app.manifest: .NET WinForms manages DPI itself, and
         declaring it in the manifest instead makes the two disagree (analyzer WFAC010). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The release asset must stay a single portable file: the README promises one .exe, and
         GitHubUpdateService applies updates by moving the downloaded AntiAFK.exe over the running
         one. A plain self-contained publish emits ~247 loose files, so the uploaded exe alone
         would not run and auto-update would break existing installs.
         IncludeNativeLibrariesForSelfExtract is required as well - without it the WindowsDesktop
         native libraries (wpfgfx_cor3, PresentationNative_cor3, D3DCompiler_47_cor3, PenImc_cor3,
         vcruntime140_cor3) are left next to the exe instead of being bundled. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- DebugType only suppresses this project's own symbols; without this the referenced
         Core/Infrastructure .pdb files are still copied next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- PublishAot is intentionally NOT used: RichTextBox registers an IRichEditOleCallback via
         COM on handle creation (RichTextBox.OnHandleCreated -> UpdateOleCallback), and the
         source-generated COM interop path required by Native AOT throws
         "System.InvalidCastException: Specified cast is not valid." there. This is a known
         WinForms/NativeAOT incompatibility, not something fixable from app code. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiAfk.Core\AntiAfk.Core.csproj" />
    <ProjectReference Include="..\AntiAfk.Infrastructure\AntiAfk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
