<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AntiAFK</AssemblyName>
    <RootNamespace>AntiAfk.App</RootNamespace>
    <ApplicationTitle>AntiAFK</ApplicationTitle>
    <Product>AntiAFK</Product>
    <Company>BxdiS</Company>
    <Description>AntiAFK marketplace activity bot</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- PublishAot is intentionally NOT used: RichTextBox registers an IRichEditOleCallback via
         COM on handle creation (RichTextBox.OnHandleCreated -> UpdateOleCallback), and the
         source-generated COM interop path required by Native AOT throws
         "System.InvalidCastException: Specified cast is not valid." there. This is a known
         WinForms/NativeAOT incompatibility, not something fixable from app code. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiAfk.Core\AntiAfk.Core.csproj" />
    <ProjectReference Include="..\AntiAfk.Infrastructure\AntiAfk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
